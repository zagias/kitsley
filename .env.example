# Generate your own random secret with at least 24 characters.
ADMIN_TOKEN=
# Optional absolute directory for catalog edits and referral events.
KITSLEY_DATA_DIR=

# Google / Apple sign-in through Supabase Auth.
# Set provider credentials in the Supabase dashboard, not here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3018
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false

# Optional server-side project assistant. No key is sent to the browser.
# Choose a Responses API model available to your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=
KITSLEY_AI_ENABLED=false
# Global preview limit across this single server, persisted in KITSLEY_DATA_DIR.
KITSLEY_AI_DAILY_LIMIT=30

# Optional retailer web-search model override and single-dyno preview allowance.
OPENAI_RETAILER_MODEL=
KITSLEY_RETAILER_DAILY_LIMIT=10
